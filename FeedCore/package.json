{
  "name": "@feed/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared core utilities, event engine, storage vault, and UI helpers for ArcaFeed and RuliFeed",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*.ts",
    "./core": "./src/core/index.ts",
    "./core/*": "./src/core/*.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*.ts",
    "./vault": "./src/vault/index.ts",
    "./vault/*": "./src/vault/*.ts",
    "./feature": "./src/feature/index.ts",
    "./feature/*": "./src/feature/*.ts",
    "./feature/modal/*": "./src/feature/modal/*.ts",
    "./feature/swiper/*": "./src/feature/swiper/*.ts"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10.9.0"
  }
}
